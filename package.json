{
  "name": "axtra-calendar-notifier",
  "version": "1.0.0",
  "description": "Monitor Google Calendar for Axtra events and send Telegram notifications",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "tsc -w",
    "auth": "ts-node src/auth.ts"
  },
  "keywords": [
    "calendar",
    "google-calendar",
    "telegram",
    "notifications"
