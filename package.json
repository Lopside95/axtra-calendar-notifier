  "dependencies": {
    "googleapis": "^129.0.0",
    "node-telegram-bot-api": "^0.66.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "@types/node-telegram-bot-api": "^0.64.3",
    "@types/express": "^4.17.21",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2"
  }
}
