# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Google Calendar Configuration
CALENDAR_NAME=Axtrazh - Urban Axe Throwing
CREDENTIALS_PATH=./credentials.json
TOKEN_PATH=./token.json

# Application Configuration
CHECK_INTERVAL_MINUTES=30
PORT=3000

# Working Days Configuration
# Set to true to automatically detect working days from existing calendar events
# Set to false to only use manually configured working days
AUTO_DETECT_WORKING_DAYS=true

# Data Storage Path (where working-days.json and notified-events.json will be stored)
DATA_PATH=./data

# Logging Configuration
# Log level: error, warn, info, debug (default: info)
LOG_LEVEL=info

# Retry Configuration for API calls
# Maximum number of retry attempts for failed API calls (default: 3)
RETRY_MAX_ATTEMPTS=3
# Initial delay between retries in milliseconds (default: 1000)
RETRY_INITIAL_DELAY_MS=1000
# Maximum delay between retries in milliseconds (default: 10000)
RETRY_MAX_DELAY_MS=10000
